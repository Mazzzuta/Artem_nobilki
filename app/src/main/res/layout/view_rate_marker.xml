<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content" android:layout_height="wrap_content"
    app:cardCornerRadius="8dp" app:cardElevation="3dp"
    app:strokeWidth="1dp" app:strokeColor="?attr/colorPrimary"
    app:cardBackgroundColor="?attr/colorSurface">
    <TextView android:id="@+id/markerText"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:padding="12dp" android:minWidth="140dp" android:maxWidth="240dp"
        android:textSize="14sp" android:textColor="?attr/colorOnSurface" />
</com.google.android.material.card.MaterialCardView>
